{
  "name": "bits-bytes-python-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"tsx watch backend/src/index.ts\" \"vite --config frontend/vite.config.ts\"",
    "setup:runtime": "node scripts/setup-runtime.mjs",
    "content": "node scripts/build-content.mjs",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "build": "npm run content && npm run setup:runtime && npm run typecheck && vite build --config frontend/vite.config.ts && tsc -p backend/tsconfig.json",
    "start": "node dist-server/index.js",
    "test": "node tests/content.test.mjs && node tests/runtime.test.mjs && node tests/guided-content.test.mjs && node tests/control-flow.test.mjs && node tests/console.test.mjs && tsx --test tests/api.test.ts tests/workspace.test.ts tests/lesson-progress.test.ts tests/runner.test.ts tests/code-presentation.test.ts tests/terminal-line.test.ts tests/terminal-session.test.ts",
    "launch": "node scripts/start.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/python": "^1.1.19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "12.10.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "express": "5.2.1",
    "pyodide": "314.0.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.18.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.1",
    "@xterm/headless": "^6.0.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.0",
    "tsx": "^4.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
